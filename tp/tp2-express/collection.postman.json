{
  "info": {
    "name": "TP 2 - Queen Bee",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "GET /health",
      "request": { "method": "GET", "url": "{{base}}/health" }
    },
    {
      "name": "GET /api/hives",
      "request": { "method": "GET", "url": "{{base}}/api/hives" }
    },
    {
      "name": "GET /api/hives?site_id=SN-CASA",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base}}/api/hives?site_id=SN-CASA",
          "host": ["{{base}}"],
          "path": ["api", "hives"],
          "query": [{ "key": "site_id", "value": "SN-CASA" }]
        }
      }
    },
    {
      "name": "GET /api/hives/SN-CASA-001",
      "request": { "method": "GET", "url": "{{base}}/api/hives/SN-CASA-001" }
    },
    {
      "name": "GET /api/hives/SN-CASA-999 (404)",
      "request": { "method": "GET", "url": "{{base}}/api/hives/SN-CASA-999" }
    },
    {
      "name": "POST /api/hives/SN-CASA-001/measures",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timestamp\": \"2026-10-31T12:00:00Z\",\n  \"weight_kg\": 36.84\n}"
        },
        "url": "{{base}}/api/hives/SN-CASA-001/measures"
      }
    }
  ]
}
